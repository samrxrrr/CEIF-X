# ================================
# CEIF-X repository exclusions
# ================================

# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
.pytest_cache/
.mypy_cache/

# Jupyter / notebooks
.ipynb_checkpoints/

# Environments
.venv/
venv/
env/
ENV/
*.conda/
*.tar.bz2

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Credentials / secrets
.env
.env.*
*.pem
*.key
credentials*
secrets*
token*
*secret*

# Logs / temporary files
*.log
*.tmp
*.temp
/tmp/
tmp/
scratch/
cache/
*_cache/

# Large biological/raw data
*.h5ad
*.h5
*.hdf5
*.mtx
*.mtx.gz
*.npz
*.npy
*.RData
*.rds
*.loom
*.bam
*.bai
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.sam
*.vcf
*.vcf.gz
*.bed
*.bed.gz
*.bigWig
*.bw

# Large compressed archives
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# Local acquisition/download areas
downloads/
download/
raw/
raw_data/
data_raw/
01_DATA_ACQUISITION/
16_multiomics_acquisition_v1/downloads/

# Large/generated matrices and intermediate objects
*_matrix.tsv
*_matrix.tsv.gz
*_expression.tsv
*_expression.tsv.gz
*_counts.tsv
*_counts.tsv.gz
*_normalized.tsv
*_normalized.tsv.gz

# Local scratch outputs
/tmp/
*.bak
*.old

# Keep publication figures/tables and reproducibility metadata tracked.
# Keep scripts, specifications, manifests, QC summaries and final analysis
# tables unless explicitly excluded above.

