# ================================
# CEIF-X additional large outputs
# ================================

# Large PCA / dimensionality-reduction matrices
03_analysis/ceif_scRNA_preintegration_pca_v1.tsv

# Large TF activity matrices
05_analysis/ceif_layer8_tf_activity_v1/

# Any generated single-cell communication run logs
05_analysis/*_run.log

# General large TSV safeguard: files >50 MB must be explicitly force-added
# only after deliberate review. Git itself has no size-based .gitignore rule.
