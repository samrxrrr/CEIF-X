      },
      {
        "name": "Description",
        "value": "Single cell RNA-sequencing has been applied to core and border regions of 9 colorectal tumors as well as to matched adjacent non-malignant colon tissue for the purpose of generating a cellular map of colorectal tumors and their tumor microenvironment."
      }
    ],
